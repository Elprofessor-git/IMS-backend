<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>0c11d375-bbb1-473e-aa93-e0b1bb409e4d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dotenv.net" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="QuestPDF" Version="2026.8.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.1" />
  </ItemGroup>

  <!-- Gabarits Excel d'export : copiés dans le répertoire de sortie (Docker + local) -->
  <ItemGroup>
    <Content Include="Templates/*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Le projet de tests est imbriqué dans ce dépôt, donc dans le périmètre des globs
    par défaut de ce projet. On l'exclut de TOUS les types d'items.

    CAUSE DE L'IMBRICATION DE bin/ (mesurée : 209 Mo, 40 niveaux) :
    le SDK Web range **/*.json en Content — appsettings.json, mais aussi
    backend.Tests/Fixtures/*.json et les .json déjà présents dans
    backend.Tests/bin/. Comme la sortie de l'API est bin/Debug/net9.0/ ET que
    backend.Tests/ vit sous le même répertoire racine, chaque build copiait un
    fichier de backend.Tests DANS bin/, donc dans un répertoire lui-même
    sous backend.Tests/ — d'où la récursion, qui doublait à chaque build et
    rendait MSBuild interminable (build au timeout).

    Trois lignes explicites (celles du projet) + DefaultItemExcludes, qui est
    la seule qui couvre Content : un bloc ne portant que sur
    Compile / EmbeddedResource / None (l'état précédent) ne fermait pas la
    porte, puisque Content n'était pas concerné. Les exclures toutes est
    défensif : si un jour un autre item a un glob par défaut, il est déjà couvert.
  -->
  <PropertyGroup>
    <!-- bin/ et obj/ du projet de tests : déjà couverts par backend.Tests/**,
         listés à part parce que ce sont eux qui s'auto-recopiaient. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);backend.Tests/**;backend.Tests/bin/**;backend.Tests/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="backend.Tests/**" />
    <Content Remove="backend.Tests/**" />
    <EmbeddedResource Remove="backend.Tests/**" />
    <None Remove="backend.Tests/**" />
  </ItemGroup>

</Project>

